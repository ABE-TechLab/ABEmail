# Copy this file to .env.local for local development.
# Use the project URL and publishable key from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep false for the email/password-first rollout. Enable only after configuring
# Google OAuth and redirect URLs in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Optional, server-only key used to resolve an assigned business-email login alias.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=

# Ottawa Snow Match pilot only. Configure in Production only and never expose to the browser.
# This is a Resend "sending access" key, restricted to ottawasnowmatch.waste2light.com.
ABEMAIL_RESEND_OTTAWA_SEND_API_KEY=
# Elevated Resend "full access" key required by Resend's domain-status and inbound-retrieval
# APIs. Isolate it to the pilot setup and inbound webhook code; do not reuse it elsewhere.
ABEMAIL_RESEND_OTTAWA_RECEIVE_API_KEY=
# Resend webhook signing secret for https://abemail.vercel.app/api/webhooks/resend
ABEMAIL_RESEND_OTTAWA_WEBHOOK_SECRET=
# Comma-separated exact, verified ABEmail login emails allowed to create/manage the pilot workspace.
ABEMAIL_PILOT_OPERATOR_EMAILS=
